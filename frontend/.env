# Frontend Environment Configuration

# API Configuration
REACT_APP_API_URL=https://mokhtarelhenawy.online/api/v1
REACT_APP_WS_URL=ws://mokhtarelhenawy.online

# App Configuration
REACT_APP_APP_NAME=Communication Platform
REACT_APP_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_AI_FEATURES=false
REACT_APP_ENABLE_ECOMMERCE=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_NOTIFICATIONS=true

# External Services (Optional)
REACT_APP_STRIPE_PUBLISHABLE_KEY=
REACT_APP_PAYPAL_CLIENT_ID=
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_FACEBOOK_APP_ID=

# Development Settings
REACT_APP_DEBUG_MODE=true
REACT_APP_LOG_LEVEL=info

# Theme Configuration
REACT_APP_DEFAULT_THEME=light
REACT_APP_DEFAULT_LANGUAGE=ar
REACT_APP_DEFAULT_DIRECTION=rtl

# Performance Settings
REACT_APP_ENABLE_SERVICE_WORKER=false
REACT_APP_ENABLE_PWA=false
